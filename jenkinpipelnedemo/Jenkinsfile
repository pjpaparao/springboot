pipeline {
    agent any

    tools {
        maven 'Maven_3.9'
        jdk 'JDK_17'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/pjpaparao/springboot.git'
            }
        }

        stage('Build & Test') {
            steps {
                dir('jenkinpipelnedemo') {
                    // Builds the JAR and runs unit tests in one execution step
                    bat 'mvn clean package'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('jenkinpipelnedemo') {
                    // Recreates services on the shared Docker Compose network
                    bat 'docker compose down'
                    bat 'docker compose up -d --build --force-recreate'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}